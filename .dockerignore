# Prevent secrets and unnecessary files from leaking into the Docker build context.
# Even without an explicit COPY, the entire context is sent to the Docker daemon.

# Secrets
# NOTE: .dockerignore patterns are anchored to the context root and are NOT
# recursive like .gitignore — prefix with **/ to exclude at every depth.
.env
.env.*
!.env.example
.local/

# Data directories (user data, tokens, logs)
data/

# Test and development artifacts
tests/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pyright/
.ruff_cache/

# Build artifacts
dist/
*.egg-info/
build/
.eggs/
*.whl

# Virtual environments
.venv/
venv/
ENV/

# Version control
.git/
.gitignore

# IDE and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Documentation (not needed in image)
*.md
Makefile

# Private keys
*.pem
*.key
*.p12
*.pfx

# Claude Code config (not needed in image), at any depth
**/.claude/

# Frontend build artifacts — the image compiles the PWA itself
# (frontend-builder stage), so host-built output must never leak into the
# build context and stale caches must not be reused.
static/
static-src/node_modules
static-src/node_modules/
static-src/*.tsbuildinfo
# Compiled Vite config left in older checkouts (GH-212). Vite loads
# vite.config.js before vite.config.ts, so a stale copy would override it.
static-src/vite.config.js
static-src/vite.config.d.ts
