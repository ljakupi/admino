# admino — Environment Variables
#
# Copy this file to .env and fill in all required values before running.
#
#   cp .env.example .env
#   $EDITOR .env
#
# NEVER commit .env to version control. It is listed in .gitignore.
# Secrets are passed to the container exclusively via environment variables —
# they are never baked into the image or written to the filesystem in plaintext.

# ------------------------------------------------------------------------------
# LLM Provider
# ------------------------------------------------------------------------------

# LLM provider: "ollama" (default, local), "anthropic" (opt-in), "openai" (opt-in)
# Proprietary providers send messages to their servers — use only if you accept this.
# LLM_PROVIDER=ollama

# Base URL for the Ollama inference server (used when LLM_PROVIDER=ollama).
# In Docker Compose with BACKEND=ollama the internal service name is "local-llm".
# Change only if running Ollama outside of Docker Compose.
OLLAMA_BASE_URL=http://local-llm:11434

# Ollama model to use for inference (used when LLM_PROVIDER=ollama).
# The model must be pulled before first use:
#   ollama pull gemma4:12b                                (native Ollama, recommended for Mac)
#   docker compose exec local-llm ollama pull gemma4:12b  (Docker Ollama via BACKEND=ollama)
#
# Recommended models (all support native tool calling):
#   gemma4:12b   — Best balance of quality + speed. ~8-10GB RAM at Q4. (recommended)
#   gemma4:e4b   — Lightweight, ~3GB RAM. Faster but lower reasoning quality.
#   gemma4:27b   — Highest quality, ~18GB RAM. Slower on M2.
OLLAMA_MODEL=gemma4:12b

# Anthropic API key (required when LLM_PROVIDER=anthropic).
# Get one at https://console.anthropic.com/
# ANTHROPIC_API_KEY=

# OpenAI API key (required when LLM_PROVIDER=openai).
# Get one at https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# Google OAuth (Gmail + Google Calendar + Google Drive)
# Required only if gmail, google_calendar, or google_drive tools are enabled
# in permissions.yaml.
# Obtain credentials from https://console.cloud.google.com/apis/credentials
# Create an "OAuth 2.0 Client ID" of type "Desktop app".
# ------------------------------------------------------------------------------

# OAuth 2.0 Client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=

# OAuth 2.0 Client Secret from Google Cloud Console.
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Microsoft OAuth (Outlook + Outlook Calendar + OneDrive)
# Required only if outlook, outlook_calendar, or onedrive tools are enabled
# in permissions.yaml.
# Register an app at https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# Use "Mobile and desktop applications" platform with redirect URI
# http://localhost:8000/oauth/callback.
# ------------------------------------------------------------------------------

# Application (client) ID from Azure AD app registration.
MICROSOFT_CLIENT_ID=

# Client secret from Azure AD app registration.
MICROSOFT_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Encryption
# ------------------------------------------------------------------------------

# Fernet symmetric encryption key used to encrypt OAuth refresh tokens at rest.
# Generate a new key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: Keep this key secret. Losing it makes stored tokens unrecoverable.
# IMPORTANT: Rotating this key requires re-running the OAuth consent flow.
# The code reads this as OAUTH_ENCRYPTION_KEY.
OAUTH_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------

# Connection URL for the PostgreSQL database. In Docker Compose the hostname
# "postgres" resolves to the postgres service on the internal network.
DATABASE_URL=postgresql://admino:${PG_PASSWORD}@postgres:5432/admino

# Password for the admino PostgreSQL user. Change this before first run.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PG_PASSWORD=changeme

# ------------------------------------------------------------------------------
# Paths (container-internal)
# These defaults match the volume mounts in docker-compose.yml.
# Only change if you customise the volume layout.
# ------------------------------------------------------------------------------

# Root directory for all mutable runtime data (logs, images, tokens).
DATA_DIR=/app/data

# Directory where config.yaml and permissions.yaml are mounted (read-only).
CONFIG_DIR=/app/config

# Full path to the append-only NDJSON audit log.
AUDIT_LOG_PATH=/app/data/logs/audit.ndjson

# ------------------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------------------

# Set to "production" for production deployments. In production mode:
#   - OCR binary must exist (hard error if missing)
#   - Stricter validation on startup
# Leave unset or "development" for local dev.
ADMINO_ENV=production

# ------------------------------------------------------------------------------
# Server / Logging
# ------------------------------------------------------------------------------

# Log level for the Python application logger.
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Authentication mode.
# "token" — require a Bearer token on every request. Set AUTH_TOKEN below.
#            Recommended default: ensures all API access is authenticated.
# "vpn"   — trust all connections (WireGuard / Tailscale handles auth at the
#            network layer). Only use when a VPN is pre-configured.
#            WARNING: with host=0.0.0.0, vpn mode exposes an unauthenticated
#            API on all network interfaces.
AUTH_MODE=token

# Bearer token for AUTH_MODE=token. Must be at least 48 characters
# with at least 20 unique characters (high entropy).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty when AUTH_MODE=vpn.
AUTH_TOKEN=

# ------------------------------------------------------------------------------
# Egress whitelist (iptables)
# Space-separated list of hostnames the agent is allowed to reach on port 443.
# The internal Docker network and loopback are always allowed regardless of this list.
#
# WARNING: Wildcard entries (e.g. *.googleapis.com) do NOT expand to subdomains.
# The '*.' prefix is stripped and only the apex domain is resolved via DNS.
# Each subdomain you need must be listed explicitly (as shown below).
# ------------------------------------------------------------------------------
EGRESS_ALLOWED_HOSTS=oauth2.googleapis.com accounts.google.com www.googleapis.com gmail.googleapis.com login.microsoftonline.com graph.microsoft.com
